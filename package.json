{
  "name": "portfolio-excalidraw",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5002",
    "typecheck": "tsc --noEmit",
    "books": "bash scripts/books.sh",
    "postinstall": "rm -rf public/fonts && cp -R node_modules/@excalidraw/excalidraw/dist/prod/fonts public/fonts"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
